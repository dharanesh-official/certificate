# Database connection string (Supabase PostgreSQL / Neon / RDS)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Secret key used for signing JWT admin session tokens (min 32 characters)
AUTH_SECRET="generate-a-secure-random-secret-key-min-32-chars"

# Public application base URL (e.g. https://your-project.vercel.app in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
